# Postiz — environment variable reference
# Copy this file to app.env and adjust as needed.

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=postiz.example.com
BASE_DOMAIN_NAME=example.com

# JWT signing secret, minimum 32 characters
APP_JWT_TOKEN=replace-with-a-random-32-character-secret

# Database
DB_CREATE_DATABASE_NAME=postiz
DB_USER_NAME=postiz
DB_USER_PASS=replace-with-a-random-password
